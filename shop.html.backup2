<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Forgewell — Shop</title>
<style>
@font-face { font-family:'Quicksand'; src:url(data:font/ttf;base64,) format('truetype'); font-weight:300 700; }
:root{ --navy:#1B4B8C; --navy-dark:#123056; --gray:#6b6b6b; --bg:#FFFFFF; --panel:#F7F8F6; --line:#E4E4E0; }
*{box-sizing:border-box;margin:0;padding:0;}
body{ background:var(--bg); color:#1a1a1a; font-family:'Quicksand',sans-serif; font-weight:500; }

header{ display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-bottom:1px solid var(--line); position:sticky; top:0; background:#fff; z-index:10; gap:12px; }
.logo-mark{ display:flex; align-items:center; gap:8px; flex-shrink:0; }
.logo-word{ font-weight:700; font-size:1.2rem; }
.logo-word .forge{ color:var(--navy); }
.logo-word .well{ color:#3FA34D; }
.menu-toggle{ display:flex; align-items:center; gap:14px; margin-left:auto; }
.hamburger{ display:flex; flex-direction:column; gap:4px; cursor:pointer; padding:4px; }
.hamburger span{ width:20px; height:2px; background:var(--navy); display:block; }
.cart-icon{ font-size:0.7rem; color:var(--navy); font-weight:700; white-space:nowrap; }

.hero{ padding:36px 20px 24px; text-align:center; background:var(--panel); border-bottom:1px solid var(--line); }
.hero h1{ font-weight:700; font-size:1.9rem; color:var(--navy-dark); margin-bottom:6px; }
.hero p{ color:var(--gray); font-size:0.85rem; max-width:420px; margin:0 auto; }

.section-heading{ padding:30px 20px 6px; font-weight:700; font-size:1.5rem; color:var(--navy-dark); }

.cat-tabs{ display:flex; gap:8px; overflow-x:auto; padding:12px 20px 10px; }
.cat-tab{ flex:0 0 auto; padding:9px 16px; border-radius:20px; font-size:0.74rem; font-weight:700; border:1.5px solid var(--line); color:var(--gray); white-space:nowrap; cursor:pointer; background:#fff; }
.cat-tab.active{ color:#fff; }

.section{ padding:10px 20px 50px; }
.grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:14px; }
.card{ background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:16px 14px 14px; position:relative; cursor:pointer; }
.badge{ position:absolute; top:10px; left:10px; background:#141414; color:#fff; font-size:0.55rem; font-weight:700; padding:3px 8px; border-radius:12px; letter-spacing:0.03em; text-transform:uppercase; z-index:2; }
.tag-pill{ position:absolute; top:10px; right:10px; color:#fff; font-size:0.5rem; font-weight:700; padding:3px 8px; border-radius:10px; letter-spacing:0.03em; text-transform:uppercase; z-index:2; }
.vial{ height:150px; border-radius:4px; background:#fff; margin-bottom:12px; display:flex; align-items:center; justify-content:center; overflow:hidden; border:1px solid var(--line); }
.vial img{ height:100%; width:auto; object-fit:contain; }
.card h3{ font-weight:700; font-size:1rem; margin-bottom:4px; color:#141414; text-align:center; }
.card p.lot{ font-size:0.68rem; color:var(--gray); margin-bottom:12px; text-align:center; }
.price-row{ display:flex; flex-direction:column; gap:8px; }
.price{ font-weight:700; font-size:0.95rem; color:var(--navy-dark); text-align:center; margin-bottom:4px; }
.buy-btn{ display:block; width:100%; text-align:center; font-size:0.75rem; font-weight:700; padding:10px; border-radius:6px; color:#fff; }
.add-btn{ display:block; width:100%; text-align:center; font-size:0.72rem; font-weight:700; padding:9px; border-radius:6px; border-width:1.5px; border-style:solid; }

footer{ padding:24px 20px 50px; border-top:1px solid var(--line); font-size:0.68rem; color:var(--gray); text-align:center; line-height:1.6; background:var(--panel); }
</style>
</head>
<body>
<style>
#age-gate-overlay{
  position:fixed; inset:0; z-index:9999;
  background:rgba(18,48,86,0.55);
  display:flex; align-items:center; justify-content:center;
  padding:20px;
}
#age-gate-modal{
  background:#fff; border-radius:12px; max-width:440px; width:100%;
  padding:28px 24px; box-shadow:0 10px 40px rgba(0,0,0,0.25);
  font-family:'Quicksand',sans-serif;
  max-height:90vh; overflow-y:auto;
}
#age-gate-modal .gate-logo{ display:flex; justify-content:center; margin-bottom:16px; }
#age-gate-modal h2{
  color:var(--navy-dark); font-size:1.3rem; font-weight:700;
  text-align:center; margin:0 0 8px;
}
#age-gate-modal .gate-sub{
  color:var(--gray); font-size:0.85rem; text-align:center; margin:0 0 20px;
}
.gate-check-box{
  border:1px solid var(--line); border-radius:8px; padding:14px;
  margin-bottom:14px; background:var(--panel);
}
.gate-check-box label{
  display:flex; align-items:flex-start; gap:10px; cursor:pointer;
  font-size:0.8rem; color:#333; line-height:1.5;
}
.gate-check-box input[type=checkbox]{
  margin-top:3px; width:16px; height:16px; flex-shrink:0; accent-color:var(--navy);
}
.gate-check-title{
  font-weight:700; color:var(--navy-dark); font-size:0.75rem;
  text-transform:uppercase; letter-spacing:0.03em; display:block; margin-bottom:4px;
}
#age-gate-modal .gate-buttons{
  display:flex; gap:10px; margin-top:18px;
}
#age-gate-modal button{
  flex:1; padding:12px; border-radius:6px; font-weight:700; font-size:0.85rem;
  cursor:pointer; border:1.5px solid var(--navy); font-family:'Quicksand',sans-serif;
}
#gate-exit-btn{ background:#fff; color:var(--navy); }
#gate-accept-btn{
  background:var(--navy); color:#fff;
  opacity:0.5; pointer-events:none; transition:opacity 0.15s;
}
#gate-accept-btn.enabled{ opacity:1; pointer-events:auto; }
body.gate-active{ overflow:hidden; }
</style>

<div id="age-gate-overlay">
  <div id="age-gate-modal">
    <div class="gate-logo">
      <svg width="40" height="40" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 60 C20 45 35 35 55 35 L105 35 C125 35 138 45 138 58 L138 68 L20 68 Z" fill="#1B4B8C"/>
        <path d="M132 42 L158 36 L158 52 L138 58 Z" fill="#1B4B8C"/>
        <rect x="65" y="68" width="20" height="16" fill="#1B4B8C"/>
        <rect x="45" y="84" width="60" height="8" rx="1.5" fill="#123056"/>
        <path d="M75 -20 C90 -10 60 5 75 15 C90 25 60 35 75 45" stroke="#3FA34D" stroke-width="6" fill="none" stroke-linecap="round"/>
        <path d="M75 -20 C60 -10 90 5 75 15 C60 25 90 35 75 45" stroke="#1B4B8C" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.55"/>
      </svg>
    </div>
    <h2>Research use only</h2>
    <p class="gate-sub">To continue, please confirm you meet the minimum age requirement and accept the agreement below.</p>

    <div class="gate-check-box">
      <label>
        <input type="checkbox" id="gate-age-check">
        <span><span class="gate-check-title">Age confirmation</span>I confirm I am 21+ years of age or older.</span>
      </label>
    </div>

    <div class="gate-check-box">
      <label>
        <input type="checkbox" id="gate-research-check">
        <span><span class="gate-check-title">Research use agreement</span>I agree that products and information on this website are provided for laboratory research use only and are not intended for use in or on humans or animals. I will not use any products or information from this website for diagnosis, treatment, cure, or prevention of any condition. I agree to follow applicable laws and regulations, and I agree to the Terms of Service and Privacy Policy.</span>
      </label>
    </div>

    <div class="gate-check-box">
      <label>
        <input type="checkbox" id="gate-remember-check" checked>
        <span><span class="gate-check-title">Remember my choice</span>Don't ask me again on this device.</span>
      </label>
    </div>

    <div class="gate-buttons">
      <button id="gate-exit-btn">Exit</button>
      <button id="gate-accept-btn">Accept</button>
    </div>
  </div>
</div>

<script>
(function(){
  var KEY = 'forgewell_age_verified';
  if (localStorage.getItem(KEY) === 'yes') return;

  document.body.classList.add('gate-active');
  var overlay = document.getElementById('age-gate-overlay');
  var ageCheck = document.getElementById('gate-age-check');
  var researchCheck = document.getElementById('gate-research-check');
  var rememberCheck = document.getElementById('gate-remember-check');
  var acceptBtn = document.getElementById('gate-accept-btn');
  var exitBtn = document.getElementById('gate-exit-btn');

  function updateAcceptState(){
    if (ageCheck.checked && researchCheck.checked) {
      acceptBtn.classList.add('enabled');
    } else {
      acceptBtn.classList.remove('enabled');
    }
  }
  ageCheck.addEventListener('change', updateAcceptState);
  researchCheck.addEventListener('change', updateAcceptState);

  acceptBtn.addEventListener('click', function(){
    if (!ageCheck.checked || !researchCheck.checked) return;
    if (rememberCheck.checked) localStorage.setItem(KEY, 'yes');
    overlay.remove();
    document.body.classList.remove('gate-active');
  });

  exitBtn.addEventListener('click', function(){
    window.location.href = 'https://www.google.com';
  });
})();
</script>


