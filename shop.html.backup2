        <span class="add-btn" style="border-color:#E0812C; color:#E0812C;">Add to Cart</span>
      </div>
    </div>
    <div class="card" data-tag="blend">
      
      <div class="tag-pill" style="background:#E0812C">Blends</div>
      <div class="vial"><img src="data:image/png;base64," alt="Bacteriostatic Water (30mL)"></div>
      <h3>Bacteriostatic Water (30mL)</h3>
      <p class="lot">30ML · MULTI-DOSE</p>
      <div class="price-row">
        <span class="price">$17.99</span>
        <span class="buy-btn" style="background:#E0812C">Buy Now</span>
        <span class="add-btn" style="border-color:#E0812C; color:#E0812C;">Add to Cart</span>
      </div>
    </div>
  </div>
</div>

<footer>
  All products are designated For Research Use Only and are supplied solely for laboratory, analytical, or scientific research by qualified professionals. Not for human or veterinary use. Not for use in diagnostic or therapeutic procedures. Not approved by the FDA or any regulatory body for human consumption, treatment, cure, or prevention of any disease. By purchasing, the buyer certifies they are a qualified researcher acquiring these products exclusively for laboratory use, and assumes full responsibility for their legal, safe, and appropriate handling in accordance with all applicable laws.
</footer>

<script>
document.querySelectorAll('.cat-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.cat-tab').forEach(t => {
      t.classList.remove('active');
      t.style.background = '#fff';
      t.style.color = '#6b6b6b';
      t.style.borderColor = '#E4E4E0';
    });
    tab.classList.add('active');
    const color = tab.dataset.color || '#141414';
    tab.style.background = color;
    tab.style.color = '#fff';
    tab.style.borderColor = color;
    const filter = tab.dataset.filter;
    document.querySelectorAll('.card').forEach(card => {
      card.style.display = (filter === 'all' || card.dataset.tag === filter) ? '' : 'none';
    });
  });
});
</script>
<script>
let allProducts = [];
let cart = JSON.parse(localStorage.getItem('forgewell_cart') || '[]');

// Maps each product's display name (must match the <h3> text on its
// card exactly) to its detail page filename.
const PRODUCT_PAGE_MAP = {
  'Semaglutide': 'forgewell-product-semaglutide.html',
  'Tirzepatide': 'forgewell-product-tirzepatide.html',
  'Retatrutide': 'forgewell-product-retatrutide.html',
  'Cagrilintide': 'forgewell-product-cagrilintide.html',
  'AOD9604': 'forgewell-product-aod9604.html',
  'Tesamorelin': 'forgewell-product-tesamorelin.html',
  'CJC-1295': 'forgewell-product-cjc-1295.html',
  'Ipamorelin': 'forgewell-product-ipamorelin.html',
  'IGF-1 LR3': 'forgewell-product-igf-1-lr3.html',
  'HCG': 'forgewell-product-hcg.html',
  'HMG': 'forgewell-product-hmg.html',
  'BPC-157': 'forgewell-product-bpc-157.html',
  'TB-500': 'forgewell-product-tb-500.html',
  'BB Blend': 'forgewell-product-bb-blend.html',
  'KLOW Blend': 'forgewell-product-klow-blend.html',
  'GHK-Cu': 'forgewell-product-ghk-cu.html',
  'Glutathione': 'forgewell-product-glutathione.html',
  'Melanotan II': 'forgewell-product-melanotan-ii.html',
  'Snap-8': 'forgewell-product-snap-8.html',
  'Bacteriostatic Water (30mL)': 'forgewell-product-bacteriostatic-water.html',
};

async function loadProducts() {
  try {
    const res = await fetch('http://localhost:3001/api/products');
    const products = await res.json();
    allProducts = products;
    document.querySelectorAll('.card').forEach(card => {
      const nameEl = card.querySelector('h3');
      if (!nameEl) return;
      const name = nameEl.textContent.trim();
      const product = products.find(p => p.name === name);
      if (!product) return;
      const lotEl = card.querySelector('.lot');
      const priceEl = card.querySelector('.price');
      if (lotEl) lotEl.textContent = product.dosage + ' · LOT #' + product.lot;
      if (priceEl) priceEl.textContent = product.price > 0 ? '$' + product.price.toFixed(2) : '$XX';
      card.dataset.productId = product.id;
    });
  } catch (err) {
    console.error('Failed to load products from backend:', err);
  }
}

function saveCart() {
  localStorage.setItem('forgewell_cart', JSON.stringify(cart));
  updateCartIcon();
}

function updateCartIcon() {
  const count = cart.reduce((sum, item) => sum + item.qty, 0);
  const icon = document.querySelector('.cart-icon');
  if (icon) icon.textContent = 'CART (' + count + ')';
}

function addToCart(productId) {
  const product = allProducts.find(p => p.id === productId);
  if (!product) return;
  const existing = cart.find(i => i.productId === productId);
  if (existing) {
    existing.qty += 1;
  } else {
    cart.push({ productId: product.id, name: product.name, price: product.price, qty: 1 });
  }
  saveCart();
}

function removeFromCart(productId) {
  cart = cart.filter(i => i.productId !== productId);
  saveCart();
  renderCart();
}

// Mirrors the exact same rule as the backend (routes/checkout.js):
// flat 10% off, either buy 3+ of one item OR spend $150+ total —
// whichever gives the bigger discount, never both stacked. This is
// just a live preview for the customer; the backend recalculates the
// real charge from scratch at checkout time, so this can't be gamed.
const BULK_QTY_THRESHOLD = 3;
const BULK_QTY_DISCOUNT = 0.10;
const CART_TOTAL_THRESHOLD = 150;
const CART_TOTAL_DISCOUNT = 0.10;

function calculateCartDiscount(cartItems) {
  let rawTotal = 0;
  let perItemTotal = 0;
  cartItems.forEach(item => {
    const lineTotal = item.price * item.qty;
    rawTotal += lineTotal;
    perItemTotal += item.qty >= BULK_QTY_THRESHOLD
      ? lineTotal * (1 - BULK_QTY_DISCOUNT)
      : lineTotal;
  });
  const cartWideTotal = rawTotal >= CART_TOTAL_THRESHOLD
    ? rawTotal * (1 - CART_TOTAL_DISCOUNT)
    : rawTotal;
  const finalTotal = Math.min(perItemTotal, cartWideTotal, rawTotal);
  return {
    subtotal: rawTotal,
    total: finalTotal,
    discountApplied: finalTotal < rawTotal,
    savings: rawTotal - finalTotal,
  };
}

function renderCart() {
  const list = document.getElementById('cart-items');
  const totalEl = document.getElementById('cart-total');
  const summaryEl = document.getElementById('cart-summary');
  if (!list) return;
  list.innerHTML = '';
  cart.forEach(item => {
    const lineTotal = item.price * item.qty;
    const row = document.createElement('div');
    row.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #E4E4E0; font-size:0.8rem;';
    row.innerHTML = '<span>' + item.name + ' x' + item.qty + '</span>' +
      '<span>$' + lineTotal.toFixed(2) + ' <span data-remove="' + item.productId + '" style="color:#C0447A; cursor:pointer; margin-left:8px;">✕</span></span>';
    list.appendChild(row);
  });

  const { subtotal, total, discountApplied, savings } = calculateCartDiscount(cart);

  if (summaryEl) {
    if (discountApplied) {
      summaryEl.innerHTML =
        '<div style="display:flex; justify-content:space-between; font-size:0.8rem; color:#666;"><span>Subtotal</span><span>$' + subtotal.toFixed(2) + '</span></div>' +
        '<div style="display:flex; justify-content:space-between; font-size:0.8rem; color:#3FA34D; font-weight:600;"><span>Bulk discount (10%)</span><span>-$' + savings.toFixed(2) + '</span></div>';
    } else {
      summaryEl.innerHTML = '';
    }
  }
  if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
  list.querySelectorAll('[data-remove]').forEach(el => {
    el.addEventListener('click', () => removeFromCart(el.dataset.remove));
  });
}

function buildCartPanel() {
  const panel = document.createElement('div');
  panel.id = 'cart-panel';
  panel.style.cssText = 'position:fixed; top:0; right:-340px; width:320px; height:100%; background:#fff; border-left:1px solid #E4E4E0; box-shadow:-4px 0 20px rgba(0,0,0,0.1); z-index:100; transition:right 0.25s; padding:20px; overflow-y:auto;';
  panel.innerHTML =
    '<h3 style="font-weight:700; margin-bottom:16px;">Your Cart</h3>' +
    '<div id="cart-items"></div>' +
    '<div id="cart-summary" style="margin-top:8px;"></div>' +
    '<div style="display:flex; justify-content:space-between; font-weight:700; margin:16px 0; font-size:0.9rem;"><span>Total</span><span id="cart-total">$0.00</span></div>' +
    '<button id="cart-checkout-btn" style="width:100%; background:#1B4B8C; color:#fff; border:none; padding:12px; border-radius:6px; font-weight:700; cursor:pointer;">Checkout</button>' +
    '<button id="cart-close-btn" style="width:100%; background:none; border:1px solid #E4E4E0; padding:10px; border-radius:6px; margin-top:8px; cursor:pointer;">Close</button>';
  document.body.appendChild(panel);

  document.getElementById('cart-close-btn').addEventListener('click', () => {
    panel.style.right = '-340px';
  });

  document.getElementById('cart-checkout-btn').addEventListener('click', async () => {
    if (cart.length === 0) {
      alert('Your cart is empty.');
      return;
    }
    const email = prompt('Enter your email to checkout:');
    if (!email) return;
    try {
      const res = await fetch('http://localhost:3001/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map(i => ({ productId: i.productId, qty: i.qty })),
          customerEmail: email
        })
      });
      const data = await res.json();
      let msg = 'Order created!\n';
      if (data.discountApplied) {
        msg += 'Subtotal: $' + data.subtotal.toFixed(2) + '\nBulk discount applied!\n';
      }
      msg += 'Total: $' + data.total + '\nOrder ID: ' + data.orderId;
      alert(msg);
      cart = [];
      saveCart();
      renderCart();
      panel.style.right = '-340px';
    } catch (err) {
      console.error('Checkout failed:', err);
      alert('Checkout failed — check the console.');
    }
  });
}

document.addEventListener('click', async (e) => {
  if (e.target.classList.contains('add-btn')) {
    const card = e.target.closest('.card');
    const productId = card?.dataset.productId;
    if (!productId) {
      alert('Product not loaded yet — try refreshing the page.');
      return;
    }
    addToCart(productId);
    return;
  }
  if (e.target.classList.contains('buy-btn')) {
    const card = e.target.closest('.card');
    const productId = card?.dataset.productId;
    if (!productId) {
      alert('Product not loaded yet — try refreshing the page.');
      return;
    }
    const email = prompt('Enter your email to checkout:');
    if (!email) return;
    try {
      const res = await fetch('http://localhost:3001/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ productId: productId, qty: 1 }],
          customerEmail: email
        })
      });
      const data = await res.json();
      let msg = 'Order created!\n';
      if (data.discountApplied) {
        msg += 'Subtotal: $' + data.subtotal.toFixed(2) + '\nBulk discount applied!\n';
      }
      msg += 'Total: $' + data.total + '\nOrder ID: ' + data.orderId;
      alert(msg);
    } catch (err) {
      console.error('Checkout failed:', err);
      alert('Checkout failed — check the console.');
    }
    return;
  }

  // Clicking anywhere else on a card (image, name, lot, price) goes to
  // that product's detail page — the buttons above are handled first
  // and return early, so they're excluded from this navigation.
  const card = e.target.closest('.card');
  if (card) {
    const nameEl = card.querySelector('h3');
    const name = nameEl?.textContent.trim();
    const filename = PRODUCT_PAGE_MAP[name];
    if (filename) {
      window.location.href = filename;
    } else {
      console.warn('No product detail page mapped for:', name);
    }
  }
});

loadProducts();
buildCartPanel();
updateCartIcon();
document.querySelector('.cart-icon').addEventListener('click', () => {
  renderCart();
  document.getElementById('cart-panel').style.right = '0';
});
</script>

</body>
</html>
